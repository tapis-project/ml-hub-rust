#!/usr/bin/env bash

projectRoot=$1
if [[ -z $projectRoot ]]; then
    echo ❌ Must provide the path to the project root
    exit 1
fi

npmrcPath=$2
if [[ -z $npmrcPath ]]; then
    echo ❌ Must provide the local path to the .npmrc file
    exit 1
fi

# --mount type=bind,source="$projectRoot/sdks/typescript-sdk/gen,target=/src/sdks/typescript-sdk/gen" \

docker run \
    -it \
    --rm \
    --mount type=bind,source="$projectRoot/sdks/typescript-sdk/,target=/src/sdks/typescript-sdk/" \
    --mount type=bind,source="$projectRoot/services/models/spec/v1/openapi.json",target=/src/services/models/spec/v1/openapi.json \
    --mount type=bind,source="$projectRoot/services/deployments/spec/v1/openapi.json",target=/src/services/deployments/spec/v1/openapi.json \
    --mount type=bind,source="$projectRoot/services/agents/spec/v1/openapi.json",target=/src/services/agents/spec/v1/openapi.json \
    --mount type=bind,source="$projectRoot/services/datasets/spec/v1/openapi.json",target=/src/services/datasets/spec/v1/openapi.json \
    --mount type=bind,source="$npmrcPath",target=/root/.npmrc \
    tapis/mlhub-typescript-sdk:local
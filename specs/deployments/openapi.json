            "name": "strategy_name",
            "in": "path",
            "description": "The name of the deployment strategy",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeployModelWithStrategyBody"

            "description": "The id of the Model Deployment",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model deployment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelDeploymentResponse"

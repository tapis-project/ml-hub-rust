#/usr/bin/env bash

assetsPath=$1
if [[ -z $assetsPath ]]; then
    echo ❌ Must provide the path to the assets directory
    exit 1
fi

here=$(dirname "${BASH_SOURCE[0]}")

docker run -it --rm --mount type=bind,source="$here",target=/src --mount type=bind,source="$assetsPath",target=/src/assets mlhub/agntcy-code-generator:latest ./src/generate
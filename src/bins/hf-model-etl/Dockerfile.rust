# Stage 1: Compile the code
# Digest refers to rust:1.93.1-trixie
FROM rust@sha256:80302520b7199f0504975bca59a914015e9fee088f759875dbbc238ca9509ee1 AS builder

ARG SERVICE_NAME
ARG SERVICE_DIR
ARG LIBS_DIR
ARG SDKS_DIR

# Create 
RUN mkdir -p /usr/local/mlhub/service/${SERVICE_NAME} /usr/local/mlhub/libs /usr/local/mlhub/sdks

# Copy shared libraries code
WORKDIR /usr/local/mlhub/libs
COPY ${LIBS_DIR} .

WORKDIR /usr/local/mlhub/sdks
COPY ${SDKS_DIR} .

# Copy service code
WORKDIR /usr/local/mlhub/service/${SERVICE_NAME}
COPY ${SERVICE_DIR} .

# Install
RUN cargo install --path .

# Stage 2: Copy the binary to a slim Linux image
FROM debian:bookworm-slim

ARG SERVICE_NAME

COPY --from=builder /usr/local/mlhub/service/${SERVICE_NAME}/target/release/${SERVICE_NAME} /usr/local/bin/mlhub

ENV RUST_LOG=debug,shared=debug

CMD ["mlhub"]
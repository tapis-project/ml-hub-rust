{
  "openapi": "3.1.0",
  "info": {
    "title": "MLHub Agents API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/agents-api/agent-records": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "List agent records",
        "operationId": "list_agent_records",
        "parameters": [
          {
            "name": "scope",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Owned",
                "Shared"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of agent records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAgentRecordsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unable to list agent records"
          }
        }
      },
      "post": {
        "tags": [
          "Agents"
        ],
        "summary": "Create an agent record",
        "operationId": "create_agent_record",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentRecordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Agent record created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAgentRecordResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unable to create agent record"
          }
        }
      }
    },
    "/agents-api/healthcheck": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentArtifactType": {
        "type": "string",
        "enum": [
          "Binary",
          "DockerImage",
          "HelmChart",
          "PythonPackage",
          "SourceCode",
          "Unspecified"
        ]
      },
      "AgentInterface": {
        "type": "object",
        "required": [
          "name",
          "protocol"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "message_binding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageBinding"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol"
          }
        }
      },
      "AgentProvider": {
        "type": "object",
        "required": [
          "organization",
          "url"
        ],
        "properties": {
          "organization": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "AgentRecord": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tenant_id",
          "owner",
          "description",
          "interfaces",
          "capabilities",
          "version",
          "artifact_locators",
          "skills",
          "visibility"
        ],
        "properties": {
          "artifact_locators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactLocator"
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "description": {
            "type": "string"
          },
          "documentation_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "interfaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentInterface"
            }
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "provider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentProvider"
              }
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentSkill"
            }
          },
          "tenant_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        }
      },
      "AgentSkill": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "tags",
          "examples"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ArtifactLocator": {
        "type": "object",
        "required": [
          "artifact_type",
          "url"
        ],
        "properties": {
          "artifact_type": {
            "$ref": "#/components/schemas/AgentArtifactType"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "streaming",
          "push_notifications"
        ],
        "properties": {
          "push_notifications": {
            "type": "boolean"
          },
          "streaming": {
            "type": "boolean"
          }
        }
      },
      "CreateAgentRecordBody": {
        "type": "object",
        "required": [
          "name",
          "description",
          "interfaces",
          "capabilities",
          "version"
        ],
        "properties": {
          "artifact_locators": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ArtifactLocator"
            },
            "default": []
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "description": {
            "type": "string"
          },
          "documentation_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "interfaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentInterface"
            }
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentProvider"
              }
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentSkill"
            }
          },
          "version": {
            "type": "string"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        },
        "additionalProperties": false
      },
      "CreateAgentRecordResponse": {
        "type": "object",
        "required": [
          "result",
          "status",
          "message",
          "metadata",
          "version"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "result": {
            "$ref": "#/components/schemas/AgentRecord"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ListAgentRecordsResponse": {
        "type": "object",
        "required": [
          "result",
          "status",
          "message",
          "metadata",
          "version"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentRecord"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        }
      },
      "MessageBinding": {
        "type": "string",
        "enum": [
          "HttpJson",
          "JsonRpc2_0",
          "Grpc"
        ]
      },
      "Protocol": {
        "type": "string",
        "enum": [
          "RestHttp",
          "Rpc",
          "Stdio"
        ]
      },
      "Visibility": {
        "type": "string",
        "enum": [
          "Public",
          "Private"
        ]
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "MLHub Agents API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/agents-api/agents": {
      "get": {
        "tags": [
          "Agents"
        ],
        "summary": "List agents",
        "operationId": "list_agents",
        "responses": {
          "200": {
            "description": "A list of agents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAgentsResponse"
                }
              }
            }
          },
          "501": {
            "description": "Agent operations are not implemented yet"
          }
        }
      },
      "post": {
        "tags": [
          "Agents"
        ],
        "summary": "Create an agent",
        "operationId": "create_agent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Agent created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAgentResponse"
                }
              }
            }
          },
          "501": {
            "description": "Agent operations are not implemented yet"
          }
        }
      }
    },
    "/agents-api/healthcheck": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tenant_id"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        }
      },
      "CreateAgentBody": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateAgentResponse": {
        "type": "object",
        "required": [
          "result",
          "status",
          "message",
          "metadata",
          "version"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "result": {
            "$ref": "#/components/schemas/Agent"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ListAgentsResponse": {
        "type": "object",
        "required": [
          "result",
          "status",
          "message",
          "metadata",
          "version"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  }
}

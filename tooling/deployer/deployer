#!/usr/bin/env bash

set -euo pipefail

stage=${1:-}
project_root=${2:-}
overlay=${3:-minikube}
poll_interval_seconds=${DEPLOYER_POLL_INTERVAL_SECONDS:-2}

if [[ -z $stage || -z $project_root ]]; then
    echo "Usage: deployer <stage> <project-root> [overlay]" >&2
    exit 2
fi

chmod +x "$project_root/dev"

migration_jobs=(
    mlhub-models-migrator
    mlhub-deployments-migrator
    mlhub-endpoints-migrator
    mlhub-federated-identities-migrator
    mlhub-principals-migrator
)

seed_jobs=(
    mlhub-hpc-cluster-seeder
)

etl_jobs=(
    mlhub-hf-model-etl
    mlhub-hf-dataset-etl
)

run_dev() {
    "$project_root/dev" "$@"
}

announce() {
    echo
    echo "==> $1"
}

build_migrations() {
    announce "Building migration images"
    run_dev build models-migrator
    run_dev build deployments-migrator
    run_dev build endpoints-migrator
    run_dev build federated-identities-migrator
    run_dev build principals-migrator

    announce "Building seed images"
    run_dev build hpc-cluster-seeder
}

build_services() {
    announce "Building API images"
    run_dev build models
    run_dev build datasets
    run_dev build deployments
    run_dev build agents
    run_dev build endpoints
    run_dev build endpoint-router

    announce "Building worker images"
    run_dev build artifact-ingester
    run_dev build artifact-publisher
    run_dev build model-deployment-controller
}

build_jobs() {
    announce "Building Hugging Face model ETL images"
    run_dev build-extract hf-model-etl
    run_dev build-transform-load hf-model-etl

    announce "Building Hugging Face dataset ETL images"
    run_dev build-extract hf-dataset-etl
    run_dev build-transform-load hf-dataset-etl
}

build_all() {
    build_migrations
    build_services
    build_jobs
}

wait_for_rollout() {
    local resource=$1

    kubectl rollout status "$resource" --timeout=0s
}

start_infra() {
    announce "Starting NFS"
    run_dev start nfs -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-nfs-server-deployment

    announce "Starting RabbitMQ"
    run_dev start rabbit -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-rabbit-deployment

    announce "Starting MongoDB"
    run_dev start mongo -t overlay "$overlay"
    wait_for_rollout statefulset/mlhub-mongo-stateful-set

    announce "Starting Traefik"
    run_dev start traefik -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-traefik-deployment
}

preflight_jobs() {
    local job
    local existing

    for job in "$@"; do
        existing=$(kubectl get job "$job" --ignore-not-found -o name)
        if [[ -n $existing ]]; then
            echo "Job '$job' already exists. Remove it explicitly before rerunning this stage." >&2
            return 1
        fi
    done
}

wait_for_job() {
    local job=$1
    local completed
    local failed

    while true; do
        completed=$(kubectl get job "$job" -o 'jsonpath={.status.conditions[?(@.type=="Complete")].status}')
        failed=$(kubectl get job "$job" -o 'jsonpath={.status.conditions[?(@.type=="Failed")].status}')

        if [[ $completed == "True" ]]; then
            echo "Job '$job' completed"
            return 0
        fi

        if [[ $failed == "True" ]]; then
            echo "Job '$job' failed" >&2
            return 1
        fi

        sleep "$poll_interval_seconds"
    done
}

run_migrations() {
    announce "Seeding HPC clusters"
    run_dev run hpc-cluster-seeder -t overlay "$overlay"
    wait_for_job mlhub-hpc-cluster-seeder

    announce "Running models migration"
    run_dev run-models migrations -t overlay "$overlay"
    wait_for_job mlhub-models-migrator

    announce "Running deployments migration"
    run_dev run-deployments migrations -t overlay "$overlay"
    wait_for_job mlhub-deployments-migrator

    announce "Running endpoints migration"
    run_dev run endpoints-migrator -t overlay "$overlay"
    wait_for_job mlhub-endpoints-migrator

    announce "Running federated identities migration"
    run_dev run-federated-identities migrations -t overlay "$overlay"
    wait_for_job mlhub-federated-identities-migrator

    announce "Running principals migration"
    run_dev run-principals migrations -t overlay "$overlay"
    wait_for_job mlhub-principals-migrator
}

start_migrations() {
    preflight_jobs "${seed_jobs[@]}" "${migration_jobs[@]}"
    run_migrations
}

start_services() {
    announce "Starting Models API"
    run_dev start models -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-models-api-deployment

    announce "Starting Datasets API"
    run_dev start datasets -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-datasets-api-deployment

    announce "Starting Deployments API"
    run_dev start deployments -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-deployments-api-deployment

    announce "Starting Agents API"
    run_dev start agents -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-agents-api-deployment

    announce "Starting Endpoints API"
    run_dev start endpoints -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-endpoints-api-deployment

    announce "Starting endpoint router"
    run_dev start endpoint-router -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-endpoint-router-deployment

    announce "Starting Envoy endpoint proxy"
    run_dev start envoy -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-endpoint-envoy-deployment

    announce "Starting artifact ingester"
    run_dev start artifact-ingester -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-artifact-ingester-deployment

    announce "Starting artifact publisher"
    run_dev start artifact-publisher -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-artifact-publisher-deployment

    announce "Starting model deployment controller"
    run_dev start model-deployment-controller -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-model-deployment-controller-deployment

    announce "Starting Gatus health dashboards"
    run_dev start gatus -t overlay "$overlay"
    wait_for_rollout deployment/mlhub-gatus-public-deployment
    wait_for_rollout deployment/mlhub-gatus-internal-deployment
}

stop_services() {
    announce "Stopping Gatus health dashboards"
    run_dev stop gatus -t overlay "$overlay"

    announce "Stopping model deployment controller"
    run_dev stop model-deployment-controller -t overlay "$overlay"

    announce "Stopping artifact publisher"
    run_dev stop artifact-publisher -t overlay "$overlay"

    announce "Stopping artifact ingester"
    run_dev stop artifact-ingester -t overlay "$overlay"

    announce "Stopping Envoy endpoint proxy"
    run_dev stop envoy -t overlay "$overlay"

    announce "Stopping endpoint router"
    run_dev stop endpoint-router -t overlay "$overlay"

    announce "Stopping Endpoints API"
    run_dev stop endpoints -t overlay "$overlay"

    announce "Stopping Agents API"
    run_dev stop agents -t overlay "$overlay"

    announce "Stopping Deployments API"
    run_dev stop deployments -t overlay "$overlay"

    announce "Stopping Datasets API"
    run_dev stop datasets -t overlay "$overlay"

    announce "Stopping Models API"
    run_dev stop models -t overlay "$overlay"
}

run_jobs() {
    announce "Running Hugging Face model ETL"
    run_dev run hf-model-etl -t overlay "$overlay"
    wait_for_job mlhub-hf-model-etl

    announce "Running Hugging Face dataset ETL"
    run_dev run hf-dataset-etl -t overlay "$overlay"
    wait_for_job mlhub-hf-dataset-etl
}

start_jobs() {
    preflight_jobs "${etl_jobs[@]}"
    run_jobs
}

start_all() {
    preflight_jobs "${seed_jobs[@]}" "${migration_jobs[@]}" "${etl_jobs[@]}"
    start_infra
    run_migrations
    start_services
    run_jobs
}

case "$stage" in
    build-migrations) build_migrations ;;
    build-services) build_services ;;
    build-jobs) build_jobs ;;
    build) build_all ;;
    start-infra) start_infra ;;
    start-migrations) start_migrations ;;
    start-services) start_services ;;
    stop-services) stop_services ;;
    start-jobs) start_jobs ;;
    start) start_all ;;
    deploy)
        build_all
        start_all
        ;;
    *)
        echo "Unknown deployer stage '$stage'" >&2
        exit 2
        ;;
esac

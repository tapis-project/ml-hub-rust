{
    "platform": "tapis-pods",
    "description": "A set of strategies for deploying models to the Tapis K8s cluster with Tapis Pods",
    "strategies": [
        {
            "name": "Pods",
            "description": "Deploys a model as an HTTP server in Tapis Pods",
            "config": {
                "supported_deployment_modalities": [ "service" ]
            },
            "use_rule_sets": [
                "FlexServerDeployerCompatible",
                "VisiblePublic"
            ],
            "use_parameter_set": "Pods",
            "enabled": true
        }
    ],
    "rule_sets": [
        {
            "name": "FlexServerDeployerCompatible",
            "rules": [
                {
                    "field_path": [
                        "provider"
                    ],
                    "operator": "Eq",
                    "value": "HuggingFace"
                },
                {
                    "field_path": [
                        "metadata",
                        "derived",
                        "inference_runtimes"
                    ],
                    "operator": "Contains",
                    "value": "transformers"
                },
                {
                    "field_path": [
                        "metadata",
                        "derived",
                        "task_types"
                    ],
                    "operator": "AnyIn",
                    "value": [
                        "TextGeneration"
                    ]
                }
            ]
        },
        {
            "name": "VisiblePublic",
            "rules": [
                {
                    "field_path": [
                        "metadata",
                        "derived",
                        "gated"
                    ],
                    "operator": "Eq",
                    "value": false
                },
                {
                    "field_path": [
                        "metadata",
                        "derived",
                        "private"
                    ],
                    "operator": "Eq",
                    "value": false
                }
            ]
        }
    ],
    "parameter_sets": [
        {
            "name": "Pods",
            "parameters": [
                {
                    "name": "backend",
                    "type": "string",
                    "required": false,
                    "default": "transformers",
                    "description": "The inference backend to use for the model deployment",
                    "choices": [
                        {
                            "value": "transformers",
                            "description": "HuggingFace's transformers library"
                        }
                    ]
                }
            ]
        }
    ]
}

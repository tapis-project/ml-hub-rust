{
    "platform": "tapis-jobs",
    "description": "A set of strategies for deploying models to cloud and HPC systems with Tapis",
    "strategies": [
        {
            "name": "TACC-HPC",
            "deployment_modality": "batch",
            "description": "Deploys a model to an HPC system at TACC",
            "use_rule_sets": [
                "FlexServCompatible",
                "CanonicalHuggingfaceVisiblePublic"
            ],
            "use_parameter_set": "TACCHPC"
        }
    ],
    "rule_sets": [
        {
            "name": "FlexServCompatible",
            "rules": [
                {
                    "field_path": [
                        "libraries"
                    ],
                    "operator": "Contains",
                    "value": "transformers"
                },
                {
                    "field_path": [
                        "task_types"
                    ],
                    "operator": "AnyIn",
                    "value": [
                        "TextGeneration"
                    ]
                }
            ]
        },
        {
            "name": "CanonicalHuggingfaceVisiblePublic",
            "rules": [
                {
                    "field_path": [
                        "canonical",
                        "gated"
                    ],
                    "operator": "In",
                    "value": [false, null]
                },
                {
                    "field_path": [
                        "canonical",
                        "private"
                    ],
                    "operator": "In",
                    "value": [false, null]
                }
            ]
        }
    ],
    "parameter_sets": [
        {
            "name": "TACCHPC",
            "parameters": [
                {
                    "name": "HPC System",
                    "type": "string",
                    "description": "An HPC system at TACC",
                    "required": true,
                    "choices": [
                        "Vista",
                        "Stampede3",
                        "Lonestar6",
                        "Frontera",
                        "Horizon"
                    ]
                },
                {
                    "name": "Slurm Project Allocation",
                    "type": "string",
                    "description": "The allocation to charge",
                    "required": false
                },
                {
                    "name": "Slurm Reservation",
                    "type": "string",
                    "description": "The slurm reservation to use",
                    "required": false
                },
                {
                    "name": "Inference Backend",
                    "type": "string",
                    "required": false,
                    "default": "transformers",
                    "description": "The inference backend to use for the model deployment",
                    "choices": [
                        "transformers"
                    ]
                },
                {
                    "name": "HuggingFace Token",
                    "type": "string",
                    "description": "The user's HuggingFace Token. Required to deploy models from private and gated HuggingFace repositories",
                    "secret": true,
                    "required": false
                }
            ]
        }
    ]
}
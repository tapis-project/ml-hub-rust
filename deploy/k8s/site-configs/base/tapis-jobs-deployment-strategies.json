{
    "platform": "tapis-jobs",
    "description": "A set of strategies for deploying models to cloud and HPC systems with Tapis",
    "strategies": [
        {
            "name": "TACC-HPC",
            "description": "Deploys a model to an HPC system at TACC",
            "config": {
                "supported_deployment_modalities": [ "batch" ]
            },
            "use_rule_sets": [
                "FlexServCompatible",
                "CanonicalHuggingfaceVisiblePublic"
            ],
            "use_parameter_set": "TACCHPC"
        }
    ],
    "rule_sets": [
        {
            "name": "FlexServCompatible",
            "rules": [
                {
                    "field_path": [
                        "libraries"
                    ],
                    "operator": "Contains",
                    "value": "transformers"
                },
                {
                    "field_path": [
                        "task_types"
                    ],
                    "operator": "AnyIn",
                    "value": [
                        "TextGeneration"
                    ]
                }
            ]
        },
        {
            "name": "CanonicalHuggingfaceVisiblePublic",
            "rules": [
                {
                    "field_path": [
                        "canonical",
                        "gated"
                    ],
                    "operator": "In",
                    "value": [false, null]
                },
                {
                    "field_path": [
                        "canonical",
                        "private"
                    ],
                    "operator": "In",
                    "value": [false, null]
                }
            ]
        }
    ],
    "parameter_sets": [
        {
            "name": "TACCHPC",
            "parameters": [
                {
                    "name": "HPC System",
                    "type": "string",
                    "description": "An HPC system at TACC",
                    "required": true,
                    "choices": [
                        {
                            "value": "Vista"
                        },
                        {
                            "value": "Stampede3"
                        },
                        {
                            "value": "Lonestar6"
                        },
                        {
                            "value": "Frontera"
                        },
                        {
                            "value": "Horizon",
                            "enabled": false
                        }
                    ]
                },
                {
                    "name": "Slurm Partition",
                    "type": "string",
                    "description": "Which Slurm partition to deploy to",
                    "required": true
                },
                {
                    "name": "Slurm Project Allocation",
                    "type": "string",
                    "description": "The allocation to charge",
                    "required": true
                },
                {
                    "name": "Slurm Reservation",
                    "type": "string",
                    "description": "The slurm reservation to use",
                    "required": false
                },
                {
                    "name": "HuggingFace Token",
                    "type": "string",
                    "description": "The user's HuggingFace Token. Required to deploy models from private and gated HuggingFace repositories",
                    "secret": true,
                    "required": false
                },
                {
                    "name": "FlexServ Token",
                    "type": "string",
                    "description": "FlexServ requires will require this token to make inference calls. If one is not provided, FlexServ will generate one for you.",
                    "secret": true,
                    "required": false
                }
            ]
        }
    ]
}
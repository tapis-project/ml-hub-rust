#!/usr/bin/env bash

set -e

echo "mlhub:"

here=$(pwd)

overlay=$1

cd "$here/traefik"
./burnup.sh "$overlay"

cd "$here/nfs"
./burnup.sh "$overlay"

echo "Waiting 5 seconds for nfs server to start"
sleep 5

cd "$here/mongo"
./burnup.sh "$overlay"
kubectl rollout status statefulset/mlhub-mongo-stateful-set --timeout=10m

cd "$here/rabbit"
./burnup.sh "$overlay"

echo "Waiting 5 seconds to let rabbit warm up"

cd "$here/artifact-ingester"
./burnup.sh "$overlay"

cd "$here/artifact-publisher"
./burnup.sh "$overlay"

echo "Starting Migrations"

cd "$here/seeders/hpc-cluster-seeder"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-hpc-cluster-seeder --timeout=10m

cd "$here/migrations/models-migrator"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-models-migrator --timeout=10m

cd "$here/migrations/deployments-migrator"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-deployments-migrator --timeout=10m

cd "$here/migrations/endpoints-migrator"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-endpoints-migrator --timeout=10m

cd "$here/migrations/principals-migrator"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-principals-migrator --timeout=10m

cd "$here/migrations/federated-identities-migrator"
./burnup.sh "$overlay"
kubectl wait --for=condition=complete job/mlhub-federated-identities-migrator --timeout=10m

echo "All migrations started"

echo "Starting APIs"

cd "$here/endpoints"
./burnup.sh "$overlay"
kubectl rollout status deployment/mlhub-endpoints-api-deployment --timeout=10m

cd "$here/endpoint-router"
./burnup.sh "$overlay"
kubectl rollout status deployment/mlhub-endpoint-router-deployment --timeout=10m

cd "$here/endpoint-envoy"
./burnup.sh "$overlay"
kubectl rollout status deployment/mlhub-endpoint-envoy-deployment --timeout=10m

cd "$here/models"
./burnup.sh "$overlay"

cd "$here/datasets"
./burnup.sh "$overlay"

cd "$here/deployments"
./burnup.sh "$overlay"

cd "$here/agents"
./burnup.sh "$overlay"

cd "$here/model-deployment-controller"
./burnup.sh "$overlay"

cd "$here/gatus"
./burnup.sh "$overlay"
kubectl rollout status deployment/mlhub-gatus-public-deployment --timeout=10m
kubectl rollout status deployment/mlhub-gatus-internal-deployment --timeout=10m


echo "Starting ETL Pipelines"

cd "$here/model-etl-pipelines/hf-model-etl"
./run.sh "$overlay"

cd "$here/dataset-etl-pipelines/hf-dataset-etl"
./run.sh "$overlay"


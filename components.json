    {
      "name": "hf-model-etl",
      "description": "Runs and ETL pipeline that pulls in model metadata from Huggingface Hub and converts it to MLHub Model Metadata",
      "rootDir": "services/hf-model-etl",
      "labels": ["bin"],
      "lifecycle": "experimental",
      "commands": {
        "initialize": "",
        "add": "cargo add --manifest-path {{ self.rootDir }}/Cargo.toml",
        "remove": "cargo remove --manifest-path {{ self.rootDir }}/Cargo.toml",
        "buildl-extract": "docker build -f {{ self.rootDir }}/Dockerfile.python -t {{ hf-model-etl-extract-image }}:{{ local }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" . && minikube image load {{ hf-model-etl-extract-image }}:{{ local }} --overwrite",
        "buildl-transform-load": "docker build -f {{ self.rootDir }}/Dockerfile.rust -t {{ hf-model-etl-transform-load-image }}:{{ local }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" --build-arg SDKS_DIR=\"{{ sdks-dir }}\" . && minikube image load {{ hf-model-etl-transform-load-image }}:{{ local }} --overwrite",
        "build-extract": "docker buildx build --platform linux/x86_64 --no-cache --progress=plain -f {{ self.rootDir }}/Dockerfile.python -t {{ extract-img }}:{{ tag }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" .",
        "build-transform-load": "docker buildx build --platform linux/x86_64 --no-cache --progress=plain -f {{ self.rootDir }}/Dockerfile.rust.{{ env }} -t {{ transform-load-img }}:{{ tag }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" --build-arg SDKS_DIR=\"{{ sdks-dir }}\" .",
        "run": "cd {{ k8s-dir }}/model-metadata-etl-pipelines/{{ self.name }} && ./run.sh {{ overlay }}",
        "install": "cargo install --path {{ self.rootDir }}",
        "pusht": "docker push --all-tags {{ extract-img }} && docker push --all-tags {{ transform-load-img }}"
      }
    },
    {
      "name": "model-deployment-controller",
      "rootDir": "services/model-deployment-controller",
      "labels": ["bin", "worker"],
      "lifecycle": "experimental",
      "commands": {
        "initialize": "",
        "get-nfs-ip": "kubectl get service {{ nfs-server-service }} -o jsonpath='{.spec.clusterIP}'",
        "start": "cd {{ k8s-dir }}/{{ self.name }} && ./burnup.sh {{ overlay }}",
        "stop": "cd {{ k8s-dir }}/{{ self.name }} && ./burndown.sh {{ overlay }}",
        "install": "cargo install --path {{ self.rootDir }}",
        "add": "cargo add --manifest-path {{ self.rootDir }}/Cargo.toml",
        "remove": "cargo remove --manifest-path {{ self.rootDir }}/Cargo.toml",
        "restart": "{{ self.rootDir }}/scripts/burndown.sh {{ project-root }}; {{ self.rootDir }}/scripts/burnup.sh {{ project-root }}",
        "build": "docker buildx build --platform linux/x86_64 --no-cache --progress=plain -f {{ self.rootDir }}/Dockerfile.{{ env }} -t {{ {{ self.name }}-image }}:{{ tag }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" .",
        "buildl": "docker build -f {{ self.rootDir }}/Dockerfile.local -t {{ {{ self.name }}-image }}:{{ local }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" --build-arg SDKS_DIR=\"{{ sdks-dir }}\" . && minikube image load {{ {{ self.name }}-image }}:{{ local }}",
        "buildp": "{{ self.commands.build }} && {{ self.commands.push }}",
        "cycle": "./manage stop {{ self.name }} && ./manage buildp {{ self.name }} && ./manage start {{ self.name }}",
        "cyclel": "{{ self.commands.start }} && {{ self.commands.stop }} && {{ self.commands.buildl }} && {{ self.commands.start }}",
        "push": "docker push {{ {{ self.name }}-image }}:{{ tag }}",
        "pusht": "docker push --all-tags {{ {{ self.name }}-image }}",
        "test": "cargo test --manifest-path {{ self.rootDir }}/Cargo.toml",
        "logs": "kubectl logs deployment/{{ {{ self.name }}-deployment }}",
        "watch": "kubectl logs deployment/{{ {{ self.name }}-deployment }} -f",
        "exec": "kubectl exec -it deployment/{{ {{ self.name }}-deployment }} -- bash",
        "code": "code {{ self.rootDir }}",
        "docs": "cargo doc --manifest-path {{ self.rootDir }}/Cargo.toml --open"
      }
    },

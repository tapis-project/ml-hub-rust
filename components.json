{
  "default-env": "minikube",
  "defaultTemplateVars": {
    "env": "local",
    "tag": "dev",
    "overlay": "minikube",
    "local": "local",
    "libs-dir": "libs",
    "sdks-dir": "sdks",
    "minik8s-dir": "deploy/k8s/minikube",
    "k8s-dir": "deploy/k8s",
    "release-flag": "debug",
    "models-deployment": "mlhub-models-api-deployment",
    "models-image": "tapis/mlhub-models-api",
    "models-migrator-image": "tapis/mlhub-models-migrator",
    "principals-migrator-image": "tapis/mlhub-principals-migrator",
    "federated-identities-migrator-image": "tapis/mlhub-federated-identities-migrator",
    "datasets-deployment": "mlhub-datasets-api-deployment",
    "datasets-image": "tapis/mlhub-datasets-api",
    "deployments-deployment": "mlhub-deployments-api-deployment",
    "deployments-image": "tapis/mlhub-deployments-api",
    "nfs-deployment": "mlhub-nfs-server-deployment",
    "nfs-server-service": "mlhub-nfs-server-service",
    "traefik-deployment": "mlhub-traefik-deployment",
    "artifact-ingester-deployment": "mlhub-artifact-ingester-deployment",
    "artifact-ingester-image": "tapis/mlhub-artifact-ingester",
    "artifact-publisher-deployment": "mlhub-artifact-publisher-deployment",
    "artifact-publisher-image": "tapis/mlhub-artifact-publisher",
    "hf-model-etl-transform-load-image": "tapis/mlhub-hf-model-etl-transform-load",
    "hf-model-etl-extract-image": "tapis/mlhub-hf-model-etl-extract",
    "model-deployment-controller-deployment": "mlhub-model-deployment-controller-deployment",
    "model-deployment-controller-image": "tapis/mlhub-model-deployment-controller",
    "project-root": "$(pwd)"
  },
  "components": [
    {
      "name": "models",
      "rootDir": "services/models",
      "labels": ["api"],
      "lifecycle": "production",
      "specPath": "services/models/spec/v1",
      "commands": {
        "initialize": "",
        "get-nfs-ip": "kubectl get service {{ nfs-server-service }} -o jsonpath='{.spec.clusterIP}'",
        "start": "cd {{ k8s-dir }}/{{ self.name }} && ./burnup.sh {{ overlay }}",
        "stop": "cd {{ k8s-dir }}/{{ self.name }} && ./burndown.sh {{ overlay }}",
        "install": "cargo install --path {{ self.rootDir }}",
        "add": "cargo add --manifest-path {{ self.rootDir }}/Cargo.toml",
        "remove": "cargo remove --manifest-path {{ self.rootDir }}/Cargo.toml",
        "restart": "./manage stop models; ./manage start models",
        "build": "docker buildx build --platform linux/x86_64 --no-cache --progress=plain -f {{ self.rootDir }}/Dockerfile.{{ env }} -t tapis/mlhub-models-api:{{ tag }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" .",
        "buildl": "docker build -f {{ self.rootDir }}/Dockerfile.local -t {{ {{ self.name }}-image }}:{{ local }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" --build-arg SDKS_DIR=\"{{ sdks-dir }}\" . && minikube image load {{ {{ self.name }}-image }}:{{ local }}",
        "buildp": "{{ self.commands.build }} && {{ self.commands.push }}",
        "cycle": "./manage stop {{ self.name }} && ./manage buildp {{ self.name }} && ./manage start {{ self.name }}",
        "cyclel": "{{ self.commands.start }} && {{ self.commands.stop }} && {{ self.commands.buildl }} && {{ self.commands.start }}",
        "push": "docker push {{ {{ self.name }}-image }}:{{ tag }}",
        "pusht": "docker push --all-tags {{ {{ self.name }}-image }}",
        "test": "cargo test --manifest-path {{ self.rootDir }}/Cargo.toml",
        "logs": "kubectl logs deployment/{{ {{ self.name }}-deployment }}",
        "watch": "kubectl logs deployment/{{ {{ self.name }}-deployment }} -f",
        "exec": "kubectl exec -it deployment/{{ {{ self.name }}-deployment }} -c models-api -- bash",
        "code": "code {{ self.rootDir }}",
        "docs": "cargo doc --manifest-path {{ self.rootDir }}/Cargo.toml --open",
        "generate-spec": "mkdir -p {{ self.specPath }} && cargo run --bin models-openapi | jq > {{ self.specPath }}/openapi.json"
      },
      "dependencies": [
        "traefik",
        "nfs"
      ]
    },
    {
      "name": "models-migrator",
      "description": "This is a standalone binary for managing the migrations of the models api. This has no seperate deployment. It must be deployed as an init container on the models api deployment",
      "rootDir": "services/models-migrator",
      "lifecycle": "experimental",
      "commands": {
        "initialize": "",
        "add": "cargo add --manifest-path {{ self.rootDir }}/Cargo.toml",
        "install": "cargo install --path {{ self.rootDir }}",
        "build": "docker buildx build --platform linux/x86_64 --no-cache --progress=plain -f {{ self.rootDir }}/Dockerfile.{{ env }} -t {{ {{ self.name }}-image }}:{{ tag }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" .",
        "buildl": "docker build -f {{ self.rootDir }}/Dockerfile.local -t {{ {{ self.name }}-image }}:{{ local }} --build-arg SERVICE_NAME={{ self.name }} --build-arg SERVICE_DIR=\"{{ self.rootDir }}\" --build-arg LIBS_DIR=\"{{ libs-dir }}\" --build-arg SDKS_DIR=\"{{ sdks-dir }}\" . && minikube image rm {{ {{ self.name }}-image }}:{{ local }} && minikube image load {{ {{ self.name }}-image }}:{{ local }}",
        "pusht": "docker push --all-tags {{ {{ self.name }}-image }}",
        "logs": "kubectl logs deployment/{{ {{ self.name }}-deployment }}",
        "watch": "kubectl logs deployment/{{ {{ self.name }}-deployment }} -f",
        "exec": "kubectl exec -it deployment/{{ {{ self.name }}-deployment }} -- bash",
        "code": "code {{ self.rootDir }}",
        "docs": "cargo doc --manifest-path {{ self.rootDir }}/Cargo.toml --open",
        "run": "cd {{ k8s-dir }}/migrations/{{ self.name }} && ./burnup.sh {{ overlay }}"
      }
    },
    {
      "name": "principals-migrator",
      "description": "This is a standalone binary for managing the migrations of the Princials collection. This has no seperate deployment. It must be deployed as a job",
      "rootDir": "services/principals-migrator",
